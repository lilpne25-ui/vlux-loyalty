# VLUX Loyalty V0.2 · variables de entorno. Copia a .env y llena SIN subir .env al repositorio.

# Conexión de la aplicación: rol vlux_app (sin BYPASSRLS). Ej. postgres://vlux_app:CAMBIAR@localhost:5432/vlux_loyalty
DATABASE_URL=
# Conexión de administración SOLO para migraciones y scripts (dueño del esquema).
DATABASE_ADMIN_URL=
# Contraseña que db:setup asigna al rol vlux_app en desarrollo local.
APP_DB_PASSWORD=

# URL pública de la app (se usa en los QR y enlaces). Ej. https://loyalty.vlux.mx
PUBLIC_BASE_URL=http://localhost:8787
PORT=8787
# production activa cookies Secure y oculta detalles de error.
NODE_ENV=development

# 1 solo si la app corre detrás de un proxy de confianza (Render, Fly, Railway) que fija x-forwarded-for.
TRUST_PROXY=0

# Token largo y aleatorio para dar de alta negocios vía /api/platform (equipo VLUX). Vacío = endpoint deshabilitado.
PLATFORM_ADMIN_TOKEN=

# Versión del aviso de privacidad vigente que acepta el cliente al registrarse.
PRIVACY_NOTICE_VERSION=borrador-2026-10
