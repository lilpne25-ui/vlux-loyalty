# VLUX Loyalty V0.2.1 · variables de entorno. Copia a .env y llena SIN subir .env al repositorio.
# En Vercel se configuran en Project Settings → Environment Variables (ver docs/DESPLIEGUE_VERCEL_SUPABASE.md).

# ===================== VARIABLES DE EJECUCIÓN (las usa la app; van en Vercel) =====================
# Conexión de la app con el rol vlux_app (sin BYPASSRLS, no dueño de tablas).
#  Local:    postgres://vlux_app:CAMBIAR@localhost:5432/vlux_loyalty
#  Supabase: Transaction Pooler (Supavisor, puerto 6543) con usuario "vlux_app.<PROJECT_REF>":
#            postgres://vlux_app.<PROJECT_REF>:<CONTRASEÑA>@aws-<N>-<REGION>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# TLS hacia la BD. Vacío = sin TLS (solo local). "supabase" = TLS verificado con el certificado raíz
# público de Supabase incluido en el código. "require" = cifrado sin verificar (solo transición).
# También puedes poner el PEM en DATABASE_SSL_CA.
DATABASE_SSL=
DATABASE_SSL_CA=
# Conexiones por instancia. Vercel: 3 (por defecto si VERCEL=1). Local: 10.
PG_POOL_MAX=

# URL pública para enlaces personales y QR. Producción: OBLIGATORIA (dominio definitivo).
# En Vercel Preview déjala VACÍA: la app usa el dominio que atendió la solicitud.
PUBLIC_BASE_URL=http://localhost:8787
PORT=8787
# production activa cookies Secure, oculta detalles de error y exige un rol de BD seguro.
NODE_ENV=development

# Solo para servidores propios detrás de un proxy que SOBRESCRIBE x-forwarded-for. En Vercel NO hace
# falta: la app usa x-vercel-forwarded-for (Vercel la fija en su borde; el cliente no puede falsificarla).
TRUST_PROXY=0

# Token largo y aleatorio (≥32 caracteres) para /api/platform (equipo VLUX). Vacío = deshabilitado.
PLATFORM_ADMIN_TOKEN=

# Versión del aviso de privacidad vigente que acepta el cliente al registrarse.
PRIVACY_NOTICE_VERSION=borrador-2026-10

# ===================== VARIABLES ADMINISTRATIVAS (NO van en Vercel) =====================
# Dueño del esquema: solo para migraciones, respaldos y scripts, desde una máquina controlada.
#  Supabase: conexión directa (db.<ref>.supabase.co:5432, IPv6) o Session Pooler (puerto 5432) como "postgres.<ref>".
DATABASE_ADMIN_URL=
# Contraseña que db:setup asigna al rol vlux_app en desarrollo LOCAL (no se usa en Supabase).
APP_DB_PASSWORD=
# Contraseña de las cuentas demo que crea db:seed:demo.
DEMO_PASSWORD=

# V0.3 · VLUX Control Center (/vlux-admin)
# 1 = habilita /api/admin en este despliegue. En Vercel queda apagado salvo que se ponga 1 (la demo pública NO lo lleva).
CONTROL_CENTER_ENABLED=
# Llave (≥32 caracteres) para cifrar los secretos TOTP de administradores. Si falta, se deriva de PLATFORM_ADMIN_TOKEN.
ADMIN_SECRETS_KEY=
# 1 = reactiva la API heredada /api/platform/* con token compartido (solo pruebas E2E heredadas).
PLATFORM_LEGACY_API=

# ===================== V0.4.5 · CORREO TRANSACCIONAL (opcional; ver docs/V045_CORREO.md) =====================
# Vacío = no se envía nada y el Control Center ofrece copiar el enlace. "mock" solo funciona fuera de producción
# (pruebas: registra el mensaje en memoria, no sale nada). "resend" requiere API key y un remitente de un dominio verificado.
EMAIL_PROVIDER=
RESEND_API_KEY=
# Ej. VLUX Loyalty <invitaciones@notificaciones.tu-dominio.mx>
EMAIL_FROM=
EMAIL_REPLY_TO=
# Secreto de firma del webhook del proveedor (whsec_...). Endpoint: POST /api/webhooks/email
EMAIL_WEBHOOK_SECRET=

# ===================== V0.4.6 · CORREO PROPIO POR SMTP (Stalwart u otro; ver docs/V046_CORREO_STALWART.md) =====================
# EMAIL_PROVIDER=smtp (alias "stalwart"). TLS siempre obligatorio y con verificación de certificado (no se puede desactivar).
SMTP_HOST=
# 587 (STARTTLS) o 465 (TLS implícito). En producción solo 465/587/2525.
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
# Opcional: CA propia en PEM (saltos de línea como \n) y nombre del certificado si difiere del host.
SMTP_CA_PEM=
SMTP_TLS_SERVERNAME=

# ===================== V0.4.6 · AVISOS WEB PUSH (opcional; ver docs/V046_NOTIFICACIONES.md) =====================
# Sin estas llaves los avisos quedan apagados y la tarjeta lo dice. La privada va solo en Vercel (Sensitive).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:… o https://…
VAPID_SUBJECT=
# Protege GET /api/internal/notifications/run (≥32 caracteres).
CRON_SECRET=
# Cada cuánto corre la tarea programada: 1 (por omisión) o 24 con Vercel Hobby.
NOTIFICATION_JOB_INTERVAL_HOURS=
# Presupuesto de cada ejecución de la tarea (ms), 2000–14000. Por omisión 11000: la función de Vercel corta a los 15 s.
NOTIFICATION_JOB_BUDGET_MS=

# ===================== 1.0.x · AYUDA VLUX EN LA TARJETA DEL CLIENTE (ver docs/release-1.0/UX_OPERATIVO_1.0.x.md) =====================
# Se fijan AL COMPILAR (Vite): cambiarlas exige volver a desplegar. Son públicas: nunca pongas secretos aquí.
# Landing comercial de VLUX Loyalty para el botón «Conocer VLUX Loyalty». Solo https://, sin usuario/contraseña ni puerto,
# dominio real (no IP ni localhost), ≤200 caracteres. Se agrega ?ref=tarjeta. Si falta o no es válida, el botón abre
# WhatsApp de VLUX (744 145 2048) con un mensaje comercial; nunca una ruta interna de la app.
VITE_VLUX_LANDING_URL=
# Opcional: lista de dominios permitidos para la landing, separados por coma (p. ej. vlux.mx,www.vlux.mx).
VITE_VLUX_LANDING_HOSTS=

# ===================== 1.0.x · RETENCIÓN DE «PERDÍ MI ACCESO» (0017) · ver docs/release-1.0/TAREA_RETENCION_0017.md =====================
# Tarea INDEPENDIENTE de los avisos: GET /api/internal/recovery/retention solo ejecuta recovery_retention_sweep();
# nunca avisos, correos ni push. Acepta Bearer RECOVERY_RETENTION_SECRET (para pruebas manuales: NO abre la ruta de
# avisos) o CRON_SECRET (el que envía Vercel Schedules). ASCII imprimible sin espacios, 32 a 512 caracteres (otro
# formato = 401 silencioso); nunca VITE_ (sería público). OJO: con CRON_SECRET presente y VAPID/SMTP configurados, quien
# tenga ese secreto también puede ejecutar la ruta de avisos.
# ?limit=1..2000 (500 por omisión) · ?dryRun=1 ejecuta y deshace (no cambia datos). Como respaldo, la app barre cada
# 10 min cuando hay actividad de recuperación.
RECOVERY_RETENTION_SECRET=
# Solo al COMPILAR en Vercel, limitada a Preview: 1 declara la schedule «recovery-retention» (47 8 * * * UTC, antes del
# respaldo diario de las 09:17 UTC). Apagada por omisión; en Production no se declara aunque exista.
VLUX_SCHEDULE_RECOVERY_RETENTION=
