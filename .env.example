# VLUX Loyalty V0.2.1 · variables de entorno. Copia a .env y llena SIN subir .env al repositorio.
# En Vercel se configuran en Project Settings → Environment Variables (ver docs/DESPLIEGUE_VERCEL_SUPABASE.md).

# ===================== VARIABLES DE EJECUCIÓN (las usa la app; van en Vercel) =====================
# Conexión de la app con el rol vlux_app (sin BYPASSRLS, no dueño de tablas).
#  Local:    postgres://vlux_app:CAMBIAR@localhost:5432/vlux_loyalty
#  Supabase: Transaction Pooler (Supavisor, puerto 6543) con usuario "vlux_app.<PROJECT_REF>":
#            postgres://vlux_app.<PROJECT_REF>:<CONTRASEÑA>@aws-<N>-<REGION>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# TLS hacia la BD. Vacío = sin TLS (solo local). "supabase" = TLS verificado con el certificado raíz
# público de Supabase incluido en el código. "require" = cifrado sin verificar (solo transición).
# También puedes poner el PEM en DATABASE_SSL_CA.
DATABASE_SSL=
DATABASE_SSL_CA=
# Conexiones por instancia. Vercel: 3 (por defecto si VERCEL=1). Local: 10.
PG_POOL_MAX=

# URL pública para enlaces personales y QR. Producción: OBLIGATORIA (dominio definitivo).
# En Vercel Preview déjala VACÍA: la app usa el dominio que atendió la solicitud.
PUBLIC_BASE_URL=http://localhost:8787
PORT=8787
# production activa cookies Secure, oculta detalles de error y exige un rol de BD seguro.
NODE_ENV=development

# Solo para servidores propios detrás de un proxy que SOBRESCRIBE x-forwarded-for. En Vercel NO hace
# falta: la app usa x-vercel-forwarded-for (Vercel la fija en su borde; el cliente no puede falsificarla).
TRUST_PROXY=0

# Token largo y aleatorio (≥32 caracteres) para /api/platform (equipo VLUX). Vacío = deshabilitado.
PLATFORM_ADMIN_TOKEN=

# Versión del aviso de privacidad vigente que acepta el cliente al registrarse.
PRIVACY_NOTICE_VERSION=borrador-2026-10

# ===================== VARIABLES ADMINISTRATIVAS (NO van en Vercel) =====================
# Dueño del esquema: solo para migraciones, respaldos y scripts, desde una máquina controlada.
#  Supabase: conexión directa (db.<ref>.supabase.co:5432, IPv6) o Session Pooler (puerto 5432) como "postgres.<ref>".
DATABASE_ADMIN_URL=
# Contraseña que db:setup asigna al rol vlux_app en desarrollo LOCAL (no se usa en Supabase).
APP_DB_PASSWORD=
# Contraseña de las cuentas demo que crea db:seed:demo.
DEMO_PASSWORD=

# V0.3 · VLUX Control Center (/vlux-admin)
# 1 = habilita /api/admin en este despliegue. En Vercel queda apagado salvo que se ponga 1 (la demo pública NO lo lleva).
CONTROL_CENTER_ENABLED=
# Llave (≥32 caracteres) para cifrar los secretos TOTP de administradores. Si falta, se deriva de PLATFORM_ADMIN_TOKEN.
ADMIN_SECRETS_KEY=
# 1 = reactiva la API heredada /api/platform/* con token compartido (solo pruebas E2E heredadas).
PLATFORM_LEGACY_API=
