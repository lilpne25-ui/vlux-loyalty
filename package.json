{
  "name": "vlux-loyalty",
  "version": "0.2.2",
  "description": "VLUX Loyalty: tarjetas de fidelidad web multiempresa",
  "scripts": {
    "dev:web": "vite",
    "build:web": "vite build",
    "typecheck": "tsc -p .",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "db:setup": "node --env-file=.env --import tsx scripts/db-setup-local.ts",
    "db:migrate": "node --env-file=.env --import tsx scripts/migrate.ts up",
    "db:rollback": "node --env-file=.env --import tsx scripts/migrate.ts down",
    "db:status": "node --env-file=.env --import tsx scripts/migrate.ts status",
    "db:setup:test": "node --env-file=.env.test --import tsx scripts/db-setup-local.ts && node --env-file=.env.test --import tsx scripts/migrate.ts up",
    "test:integration": "node --env-file=.env.test --import tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test": "npm run test:unit && npm run test:integration",
    "db:seed:demo": "node --env-file=.env --import tsx scripts/seed-demo.ts",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/index.ts",
    "dev:api": "node --env-file=.env --watch --import tsx server/index.ts",
    "test:e2e": "node --env-file=.env tests/e2e/v02-tres-dispositivos.cjs",
    "build:vercel": "vite build && node scripts/build-vercel.mjs",
    "preview:vercel": "node --env-file=.env scripts/preview-vercel-output.mjs",
    "test:e2e:v021": "node --env-file=.env tests/e2e/v021-operacion.cjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "hono": "4.13.14",
    "jsqr": "1.4.0",
    "lucide-react": "0.447.0",
    "pg": "8.23.1",
    "qrcode-generator": "1.4.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "3.4.17",
    "zod": "4.6.7"
  },
  "private": "true",
  "type": "module",
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "autoprefixer": "10.6.2",
    "postcss": "8.5.32",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "esbuild": "0.28.2"
  }
}
